# LANbu Handy Development Environment Configuration
# This file is a template for worktree-specific .env files

# Development server ports (unique per worktree)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Optional: Override host settings
BACKEND_HOST=0.0.0.0
FRONTEND_HOST=0.0.0.0

# Backend API URL for frontend (automatically set based on ports above)
VITE_API_URL=http://127.0.0.1:${BACKEND_PORT}
